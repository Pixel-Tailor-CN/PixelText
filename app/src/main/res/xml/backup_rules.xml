<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- 使用门槛和提示退出状态仅属于本次安装。 -->
    <exclude domain="sharedpref" path="engagement_prompt.xml" />
    <!-- 兼容旧版备份配置；项目最低 SDK 为 31，实际以 data_extraction_rules 为准。 -->
    <exclude domain="root" path="." />
    <exclude domain="database" path="personal_learning.db" />
    <exclude domain="database" path="personal_learning.db-wal" />
    <exclude domain="database" path="personal_learning.db-shm" />
    <exclude domain="database" path="personal_learning.db-journal" />
    <exclude domain="sharedpref" path="personal_learning_settings.xml" />
    <exclude domain="file" path="personal-learning/" />
    <exclude domain="database" path="outgoing_mms.db" />
    <exclude domain="database" path="outgoing_mms.db-wal" />
    <exclude domain="database" path="outgoing_mms.db-shm" />
    <exclude domain="file" path="mms-send-pdu/" />
    <exclude domain="database" path="message_mirror.db" />
    <exclude domain="database" path="message_mirror.db-wal" />
    <exclude domain="database" path="message_mirror.db-shm" />
    <exclude domain="file" path="mms-download/" />
    <exclude domain="sharedpref" path="mms_download_requests.xml" />
</full-backup-content>
