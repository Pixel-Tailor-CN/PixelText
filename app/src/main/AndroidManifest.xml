<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- 用户主动录制彩信音频附件，仅前台使用 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <!-- Required to interact with system SMS/MMS provider -->
    <uses-permission android:name="android.permission.WRITE_SMS" />
    <!-- Required to read contacts for picking recipients -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Required to identify SIM cards for dual-SIM support -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Required to post notifications on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 仅查询赞助入口需要打开的两个支付应用。 -->
    <queries>
        <package android:name="com.eg.android.AlipayGphone" />
        <package android:name="com.tencent.mm" />
    </queries>

    <application
        android:name=".PixelTextApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PixelText">
        
        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustNothing"
            android:theme="@style/Theme.PixelText">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.APP_MESSAGING" />
            </intent-filter>
        </activity>

        <!-- 无界面转发入口，主界面不挂在会被禁用的桌面别名下。 -->
        <activity
            android:name=".LauncherActivity"
            android:exported="false"
            android:relinquishTaskIdentity="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- 覆盖升级后同步已保存的桌面选择，避免默认别名变化导致重复入口。 -->
        <receiver
            android:name=".receiver.AppIdentityUpgradeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

