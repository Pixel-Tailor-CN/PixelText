            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name_identity_pixel_message"
            android:targetActivity=".LauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 1. BroadcastReceiver for SMS_DELIVER -->
        <receiver
            android:name=".receiver.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- 2. BroadcastReceiver for WAP_PUSH_DELIVER (MMS) -->
        <receiver
            android:name=".receiver.MmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <!-- 3. Service for RESPOND_VIA_MESSAGE (Quick Response) -->
        <service
            android:name=".service.HeadlessSmsSendService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

        <!-- 无状态快捷设置磁贴，仅用于启动应用 -->
        <service
            android:name=".service.AppLauncherTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification_sms"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>

            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="false" />
        </service>

        <!-- 4. Activity for SEND and SENDTO -->
        <activity
            android:name=".ComposeSmsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- 5. BroadcastReceiver for notification actions (mark read / reply) -->
        <receiver
            android:name=".receiver.NotificationActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="${applicationId}.action.MARK_READ" />
                <action android:name="${applicationId}.action.REPLY_SMS" />
            </intent-filter>
        </receiver>

        <receiver android:name=".sms.SmsSentReceiver" android:exported="false" />
        <receiver android:name=".mms.outgoing.MmsSentReceiver" android:exported="false" />
        <provider
            android:name=".mms.MmsSendFileProvider"
            android:authorities="${applicationId}.mms.send"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/mms_send_paths" />
        </provider>

        <!-- 6. BroadcastReceiver for MMS download completion callback -->
        <receiver
            android:name=".mms.MmsReceptionResponseReceiver"
            android:exported="false" />
        <receiver
            android:name=".mms.MmsDownloadReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="${applicationId}.action.MMS_DOWNLOADED" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".mms.MmsDownloadFileProvider"
            android:authorities="${applicationId}.mms.download"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/mms_download_paths" />
        </provider>

        <provider
            android:name=".mms.MmsAttachmentFileProvider"
            android:authorities="${applicationId}.mms.attachment"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/mms_attachment_paths" />
        </provider>

        <!-- 7. Smartspacer 验证码 Target -->
        <provider
            android:name=".smartspacer.VerificationCodeTargetProvider"
            android:authorities="${applicationId}.smartspacer.target.verification_code"
            android:exported="true"
            android:permission="com.kieronquinn.app.smartspacer.permission.ACCESS_SMARTSPACER_TARGETS">
            <intent-filter>
                <action android:name="com.kieronquinn.app.smartspacer.TARGET" />
            </intent-filter>
        </provider>

        <!-- 8. Smartspacer 未读短信数量 Complication -->
        <provider
            android:name=".smartspacer.UnreadSmsComplicationProvider"
            android:authorities="${applicationId}.smartspacer.complication.unread_sms"
            android:exported="true"
            android:permission="com.kieronquinn.app.smartspacer.permission.ACCESS_SMARTSPACER_COMPLICATIONS">
            <intent-filter>
                <action android:name="com.kieronquinn.app.smartspacer.COMPLICATION" />
            </intent-filter>
        </provider>

        <activity
            android:name=".smartspacer.UnreadSmsComplicationConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.PixelText" />

        <receiver
            android:name=".smartspacer.VerificationCodeSmartspacerActionReceiver"
            android:exported="false" />
    </application>
</manifest>
